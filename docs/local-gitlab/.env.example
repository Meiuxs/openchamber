# Copy to .env (git-ignored) or let init-env.sh generate the password for you.
# Line endings must be LF: a trailing CR ends up inside the token and GitLab answers 401.
GITLAB_ROOT_PASSWORD=replace-with-a-long-random-string

# Optional: a root personal access token with the `api` scope, created inside the
# container by create-token.rb. seed.sh needs it, the app does not.
GITLAB_TOKEN=
